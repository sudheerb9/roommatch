# Copy to .env and fill in values. Never commit .env.
# Loaded from server/config/index.js via dotenv.

NODE_ENV=development

# API port — use 3001 if the CRA dev server uses 3000 (recommended in README).
PORT=3001

# Use a long random string in any shared or production environment.
AUTH_JWT_SECRET=change-me-in-production-use-a-long-random-string

# From Google Cloud Console → OAuth 2.0 Client IDs (Web). Must match REACT_APP_GOOGLE_CLIENT_ID on the client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

LOG_LEVEL=debug

# MySQL (defaults in config match local installs)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=roommatch
DB_USER=root
DB_PASSWORD=

# In production, set DB_SYNC=false and manage schema with migrations.
DB_SYNC=true
DB_SYNC_ALTER=true
DB_QUERY_LOGGING=true

REDIS_URL=redis://127.0.0.1:6379

MATCHING_THRESHOLD=80
