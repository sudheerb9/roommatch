# Copy to .env.development.local (recommended for CRA) or .env — not committed by default.
# Rebuild after changing; CRA inlines these at build/start.

# Must match where the Express API listens (see server/.env PORT).
REACT_APP_API_BASE_URL=http://localhost:3001

# Same Google OAuth Web client ID as server GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: bypass Google in local UI by sending this Bearer token (dev only).
# REACT_APP_DEV_BEARER_TOKEN=

# Enable Autter Runtime browser tracking.
# REACT_APP_AUTTER_ENABLED=true
# Publishable client key for direct browser ingest (origin-restricted in Autter dashboard).
# REACT_APP_AUTTER_CLIENT_KEY=autter_rtc_...
